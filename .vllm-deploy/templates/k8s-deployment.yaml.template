apiVersion: apps/v1
kind: Deployment
metadata:
  name: vllm-deploy-${NODE_NAME}
  namespace: ${NAMESPACE}
  labels:
    app: vllm-deploy
    model: ${MODEL_NAME}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: vllm-deploy
      node: ${NODE_NAME}
  template:
    metadata:
      labels:
        app: vllm-deploy
        node: ${NODE_NAME}
    spec:
      nodeName: ${NODE_NAME}
      hostNetwork: true
      containers:
      - name: vllm
        image: ${IMAGE}
        command: ["sleep", "infinity"]
        env:
        - name: HCCL_IF_IP
          value: "${NODE_IP}"
        - name: GLOO_SOCKET_IFNAME
          value: "eth0"
        - name: MODEL_PATH
          value: "${MODEL_PATH}"
        resources:
          limits:
            cpu: "8"
            memory: 64Gi
            huawei.com/Ascend910: ${NPU_COUNT}
          requests:
            cpu: "8"
            memory: 64Gi
            huawei.com/Ascend910: ${NPU_COUNT}
        volumeMounts:
        - name: model-storage
          mountPath: /data
        - name: ascend-driver
          mountPath: /usr/local/Ascend
        - name: ascend-toolkit
          mountPath: /usr/local/Ascend/toolkit
        - name: dsmi
          mountPath: /usr/local/dsmi
        - name: dev-mount
          mountPath: /dev
        - name: sys-mount
          mountPath: /sys
        - name: log-mount
          mountPath: /var/log/npu
        securityContext:
          privileged: true
      volumes:
      - name: model-storage
        hostPath:
          path: ${MODEL_PATH_HOST}
          type: Directory
      - name: ascend-driver
        hostPath:
          path: /usr/local/Ascend
          type: Directory
      - name: ascend-toolkit
        hostPath:
          path: /usr/local/Ascend/toolkit
          type: DirectoryOrCreate
      - name: dsmi
        hostPath:
          path: /usr/local/dsmi
          type: Directory
      - name: dev-mount
        hostPath:
          path: /dev
      - name: sys-mount
        hostPath:
          path: /sys
      - name: log-mount
        hostPath:
          path: /var/log/npu
          type: DirectoryOrCreate